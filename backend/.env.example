# Copy ke .env
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pedulikamu?schema=public&pgbouncer=true"
# Supabase: isi dengan URI persis dari Dashboard → Connect. Untuk pooler, host, region,
# port, dan username (biasanya postgres.<project-ref>) harus cocok dengan URI tersebut.
# DIRECT_URL dipakai migrasi: koneksi direct/session port 5432, bukan transaction pooler 6543.
# Koneksi direct Supabase memakai host db.<project-ref>.supabase.co dan username postgres.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pedulikamu?schema=public"
JWT_SECRET="ganti-dengan-secret-kuat-min-32-karakter"
JWT_EXPIRES_IN="7d"
PORT=4000
FRONTEND_URL="http://localhost:3000"
COOKIE_SECURE="false"
# Deposit / commitment fee mitra (Sprint 2, docs/flowpembayaran-mitra-pasien.md #5)
DEPOSIT_AMOUNT="200000"
DEPOSIT_DURATION_MONTHS="2"
# Pembayaran layanan + payout (Sprint 4, docs/flowpembayaran-mitra-pasien.md #3-4)
ADMIN_FEE_PERCENT="10"
PAYMENT_EXPIRY_HOURS="24"
# URL gambar QRIS statis perusahaan (opsional; jika kosong frontend tampilkan placeholder + instruksi)
QRIS_IMAGE_URL=""
# Akun admin internal untuk seed (backend/prisma/seed.ts)
ADMIN_EMAIL="admin@pedulikamu.id"
ADMIN_PASSWORD="ganti-di-production"
